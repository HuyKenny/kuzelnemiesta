{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Offer import Worker (src/index.ts), replaces WP All Import. Secrets per environment (scripts/set-feed-secrets.py):
  //   IMPORT_SHARED_SECRET, FEED_URL_ZLAVOMAT (auth token), FEED_URL_ADROP.
  "name": "kuzelnemiesta-import-local",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // the Zlavomat feed is ~24 MB / 4.2k deals
  "limits": { "cpu_ms": 300000 },
  "d1_databases": [{ "binding": "DB", "database_name": "kuzelnemiesta-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../../migrations" }],
  "triggers": { "crons": [] },
  "vars": { "ALLOWED_FEED_HOSTS": "www.zlavomat.sk,www.adrop.sk", "MAX_DROP_PCT": "40", "MAX_WRITES": "2500" },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "env": {
    "staging": {
      "name": "kuzelnemiesta-import-staging",
      // HTTP API protected by the bearer secret; no cron on staging (runs are triggered by hand: POST /tick, /run/<feed>)
      "workers_dev": true,
      "preview_urls": false,
      "triggers": { "crons": [] },
      "limits": { "cpu_ms": 300000 },
      "d1_databases": [{ "binding": "DB", "database_name": "kuzelnemiesta-staging", "database_id": "a0b2c9da-760d-41bf-a52e-49823732cf66", "migrations_dir": "../../migrations" }],
      "vars": { "ALLOWED_FEED_HOSTS": "www.zlavomat.sk,www.adrop.sk", "MAX_DROP_PCT": "40", "MAX_WRITES": "2500" }
    },
    "production": {
      "name": "kuzelnemiesta-import",
      "workers_dev": true,
      "preview_urls": false,
      // every 20 min at night (UTC 1–4): the next due feed (Zlavomat 12 h, Adrop 24 h), otherwise the daily finalisation
      "triggers": { "crons": ["*/20 1-4 * * *"] },
      "limits": { "cpu_ms": 300000 },
      "d1_databases": [{ "binding": "DB", "database_name": "kuzelnemiesta-production", "database_id": "acc5cf80-fa65-4c97-bc44-2ad7d91cf4d9", "migrations_dir": "../../migrations" }],
      "vars": { "ALLOWED_FEED_HOSTS": "www.zlavomat.sk,www.adrop.sk", "MAX_DROP_PCT": "40", "MAX_WRITES": "2500" }
    }
  }
}
