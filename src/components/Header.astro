---
// Header: USP strip, logo, offer search (suggestions /api/suggest), gift shortcut, the five sections with a mega menu
// of their subcategories (groups from taxonomie.json); on phones a full-screen drawer.
import Ik from './Ik.astro';
import { tree } from '../lib/db';
import { decode } from '../lib/format';
import { getEnv } from '../lib/server/env';
import { TOP_GIFTS } from '../lib/views';

const t = await tree(getEnv().DB);
const path = Astro.url.pathname;
const sections = (t.kids.get(0) ?? []).filter((c) => c.count_total > 0).sort((a, b) => a.sort - b.sort).map((c) => {
	const kids = (t.kids.get(c.id) ?? []).filter((k) => k.count_total > 0).sort((a, b) => a.sort - b.sort);
	const groups = new Map<string, typeof kids>();
	for (const k of kids) (groups.get(k.grp) ?? groups.set(k.grp, []).get(k.grp)!).push(k);
	return { slug: c.slug, name: c.short || decode(c.name), icon: c.icon, count: c.count_total, groups: [...groups.entries()].map(([g, ks]) => ({ g, ks: ks.slice(0, 12).map((k) => ({ slug: k.slug, name: decode(k.name), icon: k.icon })) })) };
});
const gifts = TOP_GIFTS;
---
<a class="skip" href="#obsah">Přeskočit na obsah</a>
<div class="usp"><ul>
	<li><Ik n="stit" />Ověření partneři: Slevomat, Zážitky.cz, Adrop a další</li>
	<li><Ik n="mail" />Voucher přijde hned e-mailem</li>
	<li><Ik n="cena" />Cena u partnera se nemění</li>
</ul></div>
<header class="hd">
	<div class="w hd__in">
		<a class="logo" href="/" aria-label="Kouzelný děda – úvod"><img src="/a/logo-264.webp" srcset="/a/logo-264.webp 1x, /a/logo-528.webp 2x" alt="Kouzelný děda" width="148" height="48" /></a>
		<div class="hl">
			<form action="/" method="get" role="search">
				<Ik n="hledat" />
				<label class="sr" for="q">Hledat zážitky, pobyty a dárky</label>
				<input id="q" type="search" name="s" placeholder="Masáž, glamping, wellness…" autocomplete="off" data-suggest />
				<input type="hidden" name="post_type" value="product" />
				<button type="submit">Hledat</button>
			</form>
			<div class="hl__s" role="listbox" hidden></div>
		</div>
		<a class="hd__dar" href="/zazitkove-darky/"><Ik n="darek" /><span>Tipy na dárek</span></a>
		<details class="nav">
			<summary><Ik n="menu" /> Menu</summary>
			<div class="nav__p">
				<div class="nav__x"><img src="/a/logo-264.webp" alt="Kouzelný děda" width="132" height="43" /><button type="button" data-zavrit aria-label="Zavřít menu"><Ik n="zavrit" /></button></div>
				<ul>
					{sections.map((s) => (
						<li><a class="nps" href={`/${s.slug}/`}><Ik n={s.icon} />{s.name}</a>
							<ul>{s.groups.flatMap((g) => g.ks).slice(0, 10).map((k) => <li><a href={`/${k.slug}/`}>{k.name}</a></li>)}</ul></li>
					))}
					<li><a class="nps" href="/zazitkove-darky/"><Ik n="darek" />Dárky</a>
						<ul>{gifts.map((g) => <li><a href={`/${g.slug}/`}>{g.name}</a></li>)}</ul></li>
					<li><a class="nps" href="/blog/"><Ik n="jazyk" />Blog a tipy</a></li>
				</ul>
			</div>
		</details>
	</div>
	<nav class="sek-nav" aria-label="Sekce">
		<ul class="w">
			{sections.map((s) => (
				<li>
					<a class="sn" href={`/${s.slug}/`} aria-current={path === `/${s.slug}/` ? 'page' : undefined}><Ik n={s.icon} />{s.name}</a>
					<div class="mega">
						{s.groups.map((g) => <div class="mega__g">{g.g && <h3>{g.g}</h3>}<ul>{g.ks.map((k) => <li><a href={`/${k.slug}/`}><Ik n={k.icon} />{k.name}</a></li>)}</ul></div>)}
						<div class="mega__side">
							<b>{s.name}</b>
							<a class="btn btn--c" href={`/${s.slug}/`}>Všech {s.count.toLocaleString('cs-CZ')} nabídek</a>
							<ul>{gifts.slice(0, 3).map((g) => <li><a href={`/${g.slug}/`}><Ik n={g.icon} />Dárek {g.name.toLowerCase()}</a></li>)}</ul>
						</div>
					</div>
				</li>
			))}
			<li>
				<a class="sn" href="/zazitkove-darky/" aria-current={path === '/zazitkove-darky/' ? 'page' : undefined}><Ik n="darek" />Dárky</a>
				<div class="mega">
					<div class="mega__g"><h3>Pro koho</h3><ul>{gifts.filter((g) => g.slug.startsWith('darek-pro')).map((g) => <li><a href={`/${g.slug}/`}><Ik n={g.icon} />{g.name}</a></li>)}</ul></div>
					<div class="mega__g"><h3>Příležitost a rozpočet</h3><ul>{gifts.filter((g) => !g.slug.startsWith('darek-pro')).map((g) => <li><a href={`/${g.slug}/`}><Ik n={g.icon} />{g.name}</a></li>)}</ul></div>
					<div class="mega__side"><img src="/a/il/kouzelnik-darek.webp" alt="" width="84" height="84" loading="lazy" /><b>Nevíte, co darovat?</b><a class="btn btn--c" href="/zazitkove-darky/">Všechny tipy na dárek</a></div>
				</div>
			</li>
			<li><a class="sn" href="/blog/" aria-current={path.startsWith('/blog/') ? 'page' : undefined}><Ik n="jazyk" />Blog</a></li>
		</ul>
	</nav>
</header>
