---
import Produkt from '../components/stranky/Produkt.astro';
import Vypis from '../components/stranky/Vypis.astro';
import Clanek from '../components/stranky/Clanek.astro';
import Blog from '../components/stranky/Blog.astro';
import Hledani from '../components/stranky/Hledani.astro';
import Nenalezeno from '../components/stranky/Nenalezeno.astro';
import { dispatch } from '../lib/dispatch';
import { blogView, categoryView, cityView, giftView, postView, productView, searchView, storeView } from '../lib/views';
import { getEnv } from '../lib/server/env';

export const prerender = false;

const db = getEnv().DB;
const url = Astro.url;
const r = await dispatch(db, url.pathname);
if (r.kind === 'redirect') return Astro.redirect(r.to + url.search, 301);
// /page/N/ without a search term is an empty search page → the home page
if (r.kind === 'search' && !(url.searchParams.get('s') ?? '').trim()) return Astro.redirect('/', 301);

let view: any = null;
let tpl = '';
if (r.kind === 'product') { view = await productView(db, r.id); tpl = 'product'; }
else if (r.kind === 'category') { view = await categoryView(db, r.id, r.page, url.searchParams); tpl = 'list'; }
else if (r.kind === 'combo') { view = await categoryView(db, r.cat, r.page, url.searchParams, r.city); tpl = 'list'; }
else if (r.kind === 'gift') { view = await giftView(db, r.id, r.page, url.searchParams); tpl = 'list'; }
else if (r.kind === 'city') { view = await cityView(db, r.city, r.page, url.searchParams); tpl = 'list'; }
else if (r.kind === 'store') { view = await storeView(db, r.store, r.page, url.searchParams); tpl = 'list'; if (!view) return Astro.redirect('/zazitky/', 301); }
else if (r.kind === 'post' || r.kind === 'page') { view = r.page > 1 ? null : await postView(db, r.id); tpl = 'post'; }
else if (r.kind === 'blog') { view = await blogView(db, r.page); tpl = 'blog'; }
else if (r.kind === 'postcat') { view = await blogView(db, r.page, r.id); tpl = 'blog'; }
else if (r.kind === 'search') { view = await searchView(db, (url.searchParams.get('s') ?? '').trim().slice(0, 100), r.page); tpl = 'search'; }
if (view?.redirect) return Astro.redirect(view.redirect, 301);
if (!view) Astro.response.status = 404;
---
{!view && <Nenalezeno />}
{view && tpl === 'product' && <Produkt v={view} />}
{view && tpl === 'list' && <Vypis v={view} />}
{view && tpl === 'post' && <Clanek v={view} />}
{view && tpl === 'blog' && <Blog v={view} />}
{view && tpl === 'search' && <Hledani v={view} />}
