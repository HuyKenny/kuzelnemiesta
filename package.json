{
  "name": "kouzelnydeda",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "preview": "wrangler dev -c dist/server/wrangler.json --local --persist-to .wrangler/state",
