    "verify:secrets": "tsx scripts/verify-no-secrets.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "22.20.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "wrangler": "4.152.0"
  }
}
