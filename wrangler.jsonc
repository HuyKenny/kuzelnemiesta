{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Top level = local development only (miniflare, local D1).
  "name": "kuzelnemiesta-local",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "binding": "ASSETS", "directory": "./dist/client", "html_handling": "auto-trailing-slash", "not_found_handling": "none" },
  "d1_databases": [{ "binding": "DB", "database_name": "kuzelnemiesta-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "ratelimits": [
    { "name": "RL_GO", "namespace_id": "77001", "simple": { "limit": 40, "period": 60 } },
    { "name": "RL_SEARCH", "namespace_id": "77003", "simple": { "limit": 90, "period": 60 } }
  ],
  "vars": { "ENVIRONMENT": "local", "SITE_URL": "http://localhost:8798", "ALLOWED_HOSTS": "localhost,127.0.0.1" },
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  "env": {
    // Static build (Cloudflare Workers Free, 2026-11): rendered locally under `wrangler dev --local` over the SQLite state and
    // frozen into static files (scripts/static/build.py). Never deployed itself. Same vars as production so the HTML is identical;
    // no host allow-list, rate limits or services (local crawl).
    "render": {
      "name": "kuzelnemiesta-render",
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [{ "binding": "DB", "database_name": "kuzelnemiesta-render", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations" }],
      "vars": {"ENVIRONMENT": "production", "SITE_URL": "https://kuzelnemiesta.sk", "ALLOWED_HOSTS": "", "REQUIRE_ACCESS_EVERYWHERE": "0", "ANALYTICS_ENABLED": "1"}
    },
    "staging": {
      "name": "kuzelnemiesta-staging",
      // kuzelnemiesta-staging.huy-kenny.workers.dev behind Cloudflare Access (whole host); the Worker re-checks the JWT.
      "workers_dev": true,
      "preview_urls": false,
      "d1_databases": [{ "binding": "DB", "database_name": "kuzelnemiesta-staging", "database_id": "a0b2c9da-760d-41bf-a52e-49823732cf66", "migrations_dir": "migrations" }],
      "ratelimits": [
        { "name": "RL_GO", "namespace_id": "77011", "simple": { "limit": 40, "period": 60 } },
        { "name": "RL_SEARCH", "namespace_id": "77013", "simple": { "limit": 90, "period": 60 } }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "SITE_URL": "https://kuzelnemiesta-staging.huy-kenny.workers.dev",
        "ALLOWED_HOSTS": "kuzelnemiesta-staging.huy-kenny.workers.dev",
        "REQUIRE_ACCESS_EVERYWHERE": "1",
        "ANALYTICS_ENABLED": "0",
        "ACCESS_TEAM_DOMAIN": "proud-pine-5d46.cloudflareaccess.com"
      }
      // secrets: ACCESS_AUD, IP_HASH_SALT
    },
    "production": {
      "name": "kuzelnemiesta",
      // Routes kuzelnemiesta.sk/* + www.kuzelnemiesta.sk/* are added at the cutover via the CF API (deleting them = instant rollback).
      "workers_dev": true,
      "preview_urls": false,
      "d1_databases": [{ "binding": "DB", "database_name": "kuzelnemiesta-production", "database_id": "acc5cf80-fa65-4c97-bc44-2ad7d91cf4d9", "migrations_dir": "migrations" }],
      "ratelimits": [
        { "name": "RL_GO", "namespace_id": "77021", "simple": { "limit": 40, "period": 60 } },
        { "name": "RL_SEARCH", "namespace_id": "77023", "simple": { "limit": 90, "period": 60 } }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "SITE_URL": "https://kuzelnemiesta.sk",
        "ALLOWED_HOSTS": "kuzelnemiesta.sk,www.kuzelnemiesta.sk,kuzelnemiesta.huy-kenny.workers.dev",
        "REQUIRE_ACCESS_EVERYWHERE": "0",
        "ANALYTICS_ENABLED": "1"
      }
    }
  }
}
